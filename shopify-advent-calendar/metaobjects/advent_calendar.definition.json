{
  "type": "advent_calendar",
  "name": "Advent Calendar",
  "displayNameKey": "heading",
  "access": { "storefront": "PUBLIC_READ" },
  "capabilities": { "publishable": { "enabled": true } },
  "fieldDefinitions": [
    { "key": "heading", "name": "Heading", "type": "single_line_text_field", "required": true },
    { "key": "subheading", "name": "Subheading", "type": "single_line_text_field" },
    { "key": "background_type", "name": "Background type", "type": "single_line_text_field",
      "validations": [ { "name": "choices", "value": "[\"solid\",\"gradient\",\"image\"]" } ] },
    { "key": "background_color", "name": "Background color (solid)", "type": "color" },
    { "key": "gradient_color_start", "name": "Gradient start (gradient)", "type": "color" },
    { "key": "gradient_color_end", "name": "Gradient end (gradient)", "type": "color" },
    { "key": "gradient_angle", "name": "Gradient angle deg (gradient)", "type": "number_integer",
      "validations": [ { "name": "min", "value": "0" }, { "name": "max", "value": "360" } ] },
    { "key": "background_image", "name": "Background image (image)", "type": "file_reference",
      "validations": [ { "name": "file_type_options", "value": "[\"Image\"]" } ] },
    { "key": "background_image_dim", "name": "Background image dim % (image)", "type": "number_integer",
      "validations": [ { "name": "min", "value": "0" }, { "name": "max", "value": "100" } ] },
    { "key": "text_color", "name": "Text color", "type": "color" },
    { "key": "door_color", "name": "Door color", "type": "color" },
    { "key": "door_text_color", "name": "Door text color", "type": "color" },
    { "key": "accent_color", "name": "Accent color", "type": "color" },
    { "key": "show_snow", "name": "Show snow", "type": "boolean" },
    { "key": "start_date", "name": "Start date", "type": "date" },
    { "key": "days", "name": "Days", "type": "list.metaobject_reference", "required": true,
      "validations": [ { "name": "metaobject_definition_id", "value": "@ref:advent_calendar_day" } ] }
  ]
}
