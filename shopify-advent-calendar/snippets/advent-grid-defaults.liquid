{%- comment -%}
  Default grid-area for an advent door.
  Params: day (1..25), mode ('desktop' | 'mobile')
{%- endcomment -%}
{%- liquid
  assign d = day | plus: 0
  assign out = '1 / 1 / span 1 / span 1'
  case d
    when 1
      assign out = '1 / 1 / span 2 / span 2'
    when 2
      if mode == 'mobile'
        assign out = '13 / 3 / span 1 / span 1'
      else
        assign out = '5 / 5 / span 1 / span 1'
      endif
    when 3
      if mode == 'mobile'
        assign out = '5 / 2 / span 2 / span 1'
      else
        assign out = '1 / 4 / span 2 / span 1'
      endif
    when 4
      if mode == 'mobile'
        assign out = '7 / 1 / span 2 / span 2'
      else
        assign out = '3 / 6 / span 2 / span 2'
      endif
    when 5
      if mode == 'mobile'
        assign out = '5 / 3 / span 1 / span 2'
      else
        assign out = '3 / 3 / span 1 / span 2'
      endif
    when 6
      if mode == 'mobile'
        assign out = '6 / 3 / span 1 / span 2'
      else
        assign out = '5 / 1 / span 1 / span 2'
      endif
    when 7
      if mode == 'mobile'
        assign out = '13 / 4 / span 1 / span 1'
      else
        assign out = '6 / 5 / span 1 / span 1'
      endif
    when 8
      if mode == 'mobile'
        assign out = '14 / 3 / span 1 / span 1'
      else
        assign out = '8 / 4 / span 1 / span 1'
      endif
    when 9
      if mode == 'mobile'
        assign out = '5 / 1 / span 2 / span 1'
      else
        assign out = '1 / 3 / span 2 / span 1'
      endif
    when 10
      if mode == 'mobile'
        assign out = '9 / 3 / span 1 / span 2'
      else
        assign out = '5 / 6 / span 1 / span 2'
      endif
    when 11
      if mode == 'mobile'
        assign out = '10 / 3 / span 1 / span 2'
      else
        assign out = '6 / 3 / span 1 / span 2'
      endif
    when 12
      if mode == 'mobile'
        assign out = '9 / 1 / span 2 / span 1'
      else
        assign out = '1 / 5 / span 2 / span 1'
      endif
    when 13
      if mode == 'mobile'
        assign out = '1 / 3 / span 2 / span 2'
      else
        assign out = '6 / 1 / span 2 / span 2'
      endif
    when 14
      if mode == 'mobile'
        assign out = '11 / 2 / span 2 / span 1'
      else
        assign out = '7 / 3 / span 2 / span 1'
      endif
    when 15
      if mode == 'mobile'
        assign out = '14 / 4 / span 1 / span 1'
      else
        assign out = '8 / 5 / span 1 / span 1'
      endif
    when 16
      if mode == 'mobile'
        assign out = '3 / 1 / span 2 / span 2'
      else
        assign out = '1 / 6 / span 2 / span 2'
      endif
    when 17
      if mode == 'mobile'
        assign out = '11 / 3 / span 1 / span 2'
      else
        assign out = '6 / 6 / span 1 / span 2'
      endif
    when 18
      if mode == 'mobile'
        assign out = '14 / 1 / span 1 / span 1'
      else
        assign out = '3 / 5 / span 1 / span 1'
      endif
    when 19
      if mode == 'mobile'
        assign out = '14 / 2 / span 1 / span 1'
      else
        assign out = '4 / 5 / span 1 / span 1'
      endif
    when 20
      if mode == 'mobile'
        assign out = '12 / 3 / span 1 / span 2'
      else
        assign out = '8 / 1 / span 1 / span 2'
      endif
    when 21
      if mode == 'mobile'
        assign out = '7 / 3 / span 2 / span 2'
      else
        assign out = '7 / 6 / span 2 / span 2'
      endif
    when 22
      if mode == 'mobile'
        assign out = '9 / 2 / span 2 / span 1'
      else
        assign out = '3 / 1 / span 2 / span 1'
      endif
    when 23
      if mode == 'mobile'
        assign out = '13 / 1 / span 1 / span 2'
      else
        assign out = '7 / 4 / span 1 / span 2'
      endif
    when 24
      if mode == 'mobile'
        assign out = '11 / 1 / span 2 / span 1'
      else
        assign out = '3 / 2 / span 2 / span 1'
      endif
    when 25
      if mode == 'mobile'
        assign out = '3 / 3 / span 2 / span 2'
      else
        assign out = '4 / 3 / span 2 / span 2'
      endif
  endcase
  echo out
-%}
