{%- comment -%}
  Hidden per-day overlay content. Param: day_entry (advent_calendar_day)
  Cloned into .advent__portal by advent-calendar.js
{%- endcomment -%}
{%- assign n = day_entry.day.value | plus: 0 -%}
<template class="advent__tpl" data-day="{{ n }}">
  <div class="advent__card-inner">
    <div class="advent__medallion" aria-hidden="true">{{ n }}</div>
    <h3 class="advent__card-title" data-overlay-title>{{ day_entry.title.value }}</h3>
    {%- if day_entry.image.value != blank -%}
      {{ day_entry.image.value | image_url: width: 720 | image_tag: loading: 'lazy', class: 'advent__card-image', alt: day_entry.title.value }}
    {%- endif -%}
    <div class="advent__card-message">{%- render 'advent-richtext', node: day_entry.message.value -%}</div>
    {%- if day_entry.code.value != blank -%}
      <button type="button" class="advent__code" data-code="{{ day_entry.code.value | escape }}" aria-label="Copiar código">
        <span class="advent__code-text">{{ day_entry.code.value }}</span>
        <span class="advent__code-hint" aria-hidden="true">
          <svg class="advent__code-icon advent__code-icon--copy" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 11C6 8.17157 6 6.75736 6.87868 5.87868C7.75736 5 9.17157 5 12 5H15C17.8284 5 19.2426 5 20.1213 5.87868C21 6.75736 21 8.17157 21 11V16C21 18.8284 21 20.2426 20.1213 21.1213C19.2426 22 17.8284 22 15 22H12C9.17157 22 7.75736 22 6.87868 21.1213C6 20.2426 6 18.8284 6 16V11Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M6 19C4.34315 19 3 17.6569 3 16V10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H15C16.6569 2 18 3.34315 18 5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <svg class="advent__code-icon advent__code-icon--check" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 12.5L9 17.5L20 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    {%- endif -%}
    {%- if day_entry.link_url.value != blank -%}
      <a class="advent__cta" href="{{ day_entry.link_url.value }}">
        {{ day_entry.link_label.value | default: 'Ver mais' }}
      </a>
    {%- endif -%}
  </div>
  <div class="advent__card-watermark" aria-hidden="true">
    {%- render 'advent-motif', name: day_entry.motif.value, class: 'advent__motif' -%}
  </div>
  {%- comment -%}
    Cover panel: sits over the content and fades away on open to reveal it.
    The diagonal glint sweeps across as it lifts. Both are driven by the
    .advent__card--revealing class that advent-calendar.js toggles.
  {%- endcomment -%}
  <div class="advent__card-leaf" aria-hidden="true">
    {%- render 'advent-motif', name: day_entry.motif.value, class: 'advent__motif' -%}
    <div class="advent__card-shine"></div>
  </div>
</template>
